# Copy to .env for local runs. On Render set these in the dashboard instead.
ANTHROPIC_API_KEY=
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (works on Render's IPv4 network)
DATABASE_URL=
# Comma-separated Vercel origins allowed to call the API, no trailing slash
CORS_ORIGINS=http://localhost:5055
# Demo logins. CHANGE THESE for any public deployment.
DEMO_PIN_DOH=2026
DEMO_PIN_RESIDENT=1111
DEMO_PIN_DOCTOR=2222
AI_CALLS_PER_HOUR=30
