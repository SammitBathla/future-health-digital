{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/doh",    "destination": "/doh/index.html" },
    { "source": "/app",    "destination": "/app/index.html" },
    { "source": "/doctor", "destination": "/doctor/index.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/doh", "permanent": false }
  ]
}
